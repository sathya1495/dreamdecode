{
  "expo": {
    "name": "DreamDecode: AI Dream Journal",
    "slug": "DreamDecode",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dreamdecode",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E27"
    },
    "android": {
      "package": "com.dreamdecode.ai",
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0E27"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-navigation-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7C5CFC"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2706099218703199~5735003013",
          "iosAppId": "ca-app-pub-2706099218703199~5735003013"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "groqApiKey": "",
      "eas": {
        "projectId": "066d0957-a351-4873-a5a8-1796a2624221"
      },
      "router": {}
    },
    "owner": "sathya1495"
  }
}
